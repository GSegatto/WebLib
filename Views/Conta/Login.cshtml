@model LoginViewModel
@{ ViewData["Title"] = "Entrar"; }

<div class="auth-split card">
    <div class="auth-imagem d-none d-md-block"></div>
    <div class="p-4 p-md-5">
            <h1 class="h4 mb-3">Entrar</h1>
            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="email" autofocus />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Senha" class="form-label"></label>
                    <input asp-for="Senha" class="form-control" />
                    <span asp-validation-for="Senha" class="text-danger"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="Lembrar" class="form-check-input" />
                    <label asp-for="Lembrar" class="form-check-label"></label>
                </div>
                <button class="btn btn-primary w-100">Entrar</button>
            </form>
            <p class="mt-3 mb-0 text-center">Não tem conta? <a asp-action="Registrar">Criar conta</a></p>
    </div>
</div>
