@model LivroFormViewModel

@{
    ViewData["Title"] = Model.Id == 0 ? "Novo livro" : "Editar livro";
    var editando = Model.Id != 0;
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="mb-1">
            @ViewData["Title"]
        </h2>

        <p class="text-muted mb-0">
            @(editando
                ? "Altere as informações do livro."
                : "Cadastre um novo livro na biblioteca.")
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <form method="post" enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="row">

                    <div class="col-md-8 mb-4">
                        <label asp-for="Titulo" class="form-label">
                            Título
                        </label>

                        <input asp-for="Titulo"
                               class="form-control"
                               placeholder="Digite o título do livro" />

                        <span asp-validation-for="Titulo"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-4">
                        <label asp-for="Isbn" class="form-label">
                            ISBN
                        </label>

                        <input asp-for="Isbn"
                               class="form-control"
                               placeholder="Digite o ISBN" />

                        <span asp-validation-for="Isbn"
                              class="text-danger"></span>
                    </div>

                </div>

                <!-- Descrição -->

                <div class="mb-4">
                    <label asp-for="Descricao" class="form-label">
                        Descrição
                    </label>

                    <textarea asp-for="Descricao"
                              class="form-control"
                              rows="5"
                              placeholder="Digite uma descrição ou sinopse do livro..."></textarea>

                    <span asp-validation-for="Descricao"
                          class="text-danger"></span>
                </div>

                <div class="row">

                    <div class="col-md-4 mb-4">
                        <label asp-for="AnoPublicacao" class="form-label">
                            Ano de publicação
                        </label>

                        <input asp-for="AnoPublicacao"
                               class="form-control"
                               type="number"
                               placeholder="Ex.: 2026" />

                        <span asp-validation-for="AnoPublicacao"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-4">
                        <label asp-for="CategoriaId" class="form-label">
                            Categoria
                        </label>

                        <select asp-for="CategoriaId"
                                asp-items="Model.Categorias"
                                class="form-select">

                            <option value="">Selecione a categoria...</option>

                        </select>

                        <span asp-validation-for="CategoriaId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-4">
                        <label asp-for="EditoraId" class="form-label">
                            Editora
                        </label>

                        <select asp-for="EditoraId"
                                asp-items="Model.Editoras"
                                class="form-select">

                            <option value="">Selecione a editora...</option>

                        </select>

                        <span asp-validation-for="EditoraId"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="mb-4">

                    <div class="form-check">
                        <input asp-for="Destaque"
                               class="form-check-input"
                               type="checkbox" />

                        <label asp-for="Destaque"
                               class="form-check-label">
                            Exibir nos Destaques da biblioteca
                        </label>
                    </div>

                    <div class="form-text">
                        Livros marcados aparecerão na seção de destaques da página inicial.
                    </div>

                </div>

                <div class="mb-4">
                    <label asp-for="Capa" class="form-label">
                        Capa do livro
                    </label>

                    <input asp-for="Capa"
                           class="form-control"
                           type="file"
                           accept=".jpg,.jpeg,.png,.webp" />

                    <div class="form-text">
                        Formatos permitidos: JPG, JPEG, PNG ou WEBP. Máximo: 5 MB.
                    </div>

                    <span asp-validation-for="Capa"
                          class="text-danger"></span>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.CapaAtual))
                {
                    <div class="mb-4">

                        <label class="form-label">
                            Capa atual
                        </label>

                        <div>
                            <img src="@Model.CapaAtual"
                                 alt="Capa atual de @Model.Titulo"
                                 class="capa-preview" />
                        </div>

                    </div>
                }

                <hr class="my-4" />

                <div class="mb-3">
                    <h5 class="mb-1">
                        Autores
                    </h5>

                    <p class="text-muted small mb-0">
                        Selecione um ou mais autores relacionados ao livro.
                    </p>
                </div>

                <div class="mb-4">

                    <select asp-for="AutoresIds"
                            asp-items="Model.Autores"
                            class="form-select"
                            size="6">
                    </select>

                    <div class="form-text">
                        Segure Ctrl (ou Cmd) para selecionar mais de um autor.
                    </div>

                    <span asp-validation-for="AutoresIds"
                          class="text-danger"></span>

                </div>

                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>
                        Salvar
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>