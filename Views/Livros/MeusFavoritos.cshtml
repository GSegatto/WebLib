@model MeusFavoritosViewModel

@{
    ViewData["Title"] = "Meus favoritos";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="mb-1">
            Meus favoritos
        </h2>

        <p class="text-muted mb-0">
            Livros que você salvou para consultar depois.
        </p>
    </div>

    @if (!Model.Livros.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">

                <i class="bi bi-heart fs-1 text-muted"></i>

                <h5 class="mt-3">
                    Você ainda não tem favoritos
                </h5>

                <p class="text-muted mb-4">
                    Encontre um livro no catálogo e clique no coração
                    para salvá-lo aqui.
                </p>

                <a asp-controller="Livros"
                   asp-action="Index"
                   class="btn btn-primary">

                    <i class="bi bi-search me-1"></i>
                    Explorar catálogo

                </a>

            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">

            @foreach (var l in Model.Livros)
            {
                <div class="col">

                    <div class="card livro-card h-100">

                        <div class="livro-capa-wrapper">

                            <a asp-controller="Livros"
                               asp-action="Details"
                               asp-route-id="@l.Id"
                               class="livro-capa"
                               aria-label="Ver @l.Titulo"
                               style="@(string.IsNullOrWhiteSpace(l.Capa)
                                    ? ""
                                    : $"background-image: url('{l.Capa}');")">
                            </a>

                            <form asp-controller="Livros"
                                  asp-action="Desfavoritar"
                                  asp-route-id="@l.Id"
                                  method="post"
                                  class="favorito-form">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="favorito-btn"
                                        title="Remover dos favoritos"
                                        aria-label="Remover dos favoritos">

                                    <i class="bi bi-heart-fill"></i>

                                </button>

                            </form>

                        </div>

                        <div class="card-body d-flex flex-column">

                            <h5 class="livro-titulo">
                                @l.Titulo
                            </h5>

                            <p class="livro-meta mb-1">
                                <i class="bi bi-person me-1"></i>
                                @l.Autores
                            </p>

                            <p class="livro-meta">
                                <i class="bi bi-tag me-1"></i>
                                @l.Categoria · @l.AnoPublicacao
                            </p>

                            <div class="mb-3">

                                @if (l.ExemplaresDisponiveis > 0)
                                {
                                    <span class="badge text-bg-success">
                                        <i class="bi bi-check-circle me-1"></i>
                                        @l.ExemplaresDisponiveis disponível(is)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">
                                        Indisponível
                                    </span>
                                }

                            </div>

                            <div class="livro-acoes mt-auto">

                                <a asp-controller="Livros"
                                   asp-action="Details"
                                   asp-route-id="@l.Id"
                                   class="btn btn-sm btn-outline-primary">

                                    <i class="bi bi-eye me-1"></i>
                                    Ver livro

                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>