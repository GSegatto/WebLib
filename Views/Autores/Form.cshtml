@model NomeViewModel

@{
    ViewData["Title"] = Model.Id == 0 ? "Novo autor" : "Editar autor";
    var editando = Model.Id != 0;
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="mb-1">
            @ViewData["Title"]
        </h2>

        <p class="text-muted mb-0">
            @(editando
                ? "Altere as informações do autor."
                : "Cadastre um novo autor na biblioteca.")
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <form method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="mb-4">
                    <label asp-for="Nome" class="form-label">
                        Nome
                    </label>

                    <input asp-for="Nome"
                           class="form-control"
                           placeholder="Digite o nome do autor" />

                    <span asp-validation-for="Nome"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>
                        Salvar
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>