@model CategoriaFormViewModel

@{
    ViewData["Title"] = Model.Id == 0
        ? "Nova categoria"
        : "Editar categoria";

    var editando = Model.Id != 0;
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="mb-1">@ViewData["Title"]</h2>

        <p class="text-muted mb-0">
            @(editando
                ? "Altere as informações da categoria."
                : "Cadastre uma nova categoria na biblioteca.")
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <form method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImagemAtual" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="mb-4">
                    <label asp-for="Nome" class="form-label">
                        Nome
                    </label>

                    <input asp-for="Nome"
                           class="form-control"
                           placeholder="Digite o nome da categoria" />

                    <span asp-validation-for="Nome"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ArquivoImagem"
                           class="form-label">
                        Imagem da categoria
                    </label>

                    @if (!string.IsNullOrWhiteSpace(Model.ImagemAtual))
                    {
                        <div class="mb-3">
                            <img src="@Model.ImagemAtual"
                                 alt="Imagem atual da categoria"
                                 style="width: 180px; height: 120px; object-fit: cover;"
                                 class="rounded border" />
                        </div>
                    }

                    <input asp-for="ArquivoImagem"
                           type="file"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp" />

                    <div class="form-text">
                        Formatos aceitos: JPG, PNG e WebP. Tamanho máximo: 5 MB.
                        Se não selecionar outra imagem, a atual será mantida.
                    </div>

                    <span asp-validation-for="ArquivoImagem"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>
                        Salvar
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>