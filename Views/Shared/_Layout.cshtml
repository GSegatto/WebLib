@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    var admin = User.IsInRole(Perfis.Admin);
    var nome = User.Identity?.Name ?? "";
    var inicial = string.IsNullOrEmpty(nome) ? "?" : nome.Substring(0, 1).ToUpper();
}
<!DOCTYPE html>
<html lang="pt-br" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/png" href="~/img/favicon.jpg">
    <title>@ViewData["Title"] - Biblioteca</title>
    <script>
        // Aplica tema/tamanho de fonte salvos ANTES de renderizar (evita "piscar" branco).
        (function () {
            try {
                var t = localStorage.getItem('tema') || 'auto';
                var dark = t === 'escuro' || (t === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
                document.documentElement.setAttribute('data-bs-theme', dark ? 'dark' : 'light');
                if (localStorage.getItem('fonte') === 'grande') document.documentElement.style.fontSize = '112.5%';
            } catch (e) { }
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom mb-4">
    <div class="container">

       @*===== LOGO DO SITE NOS DOIS MODOS =====*@
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
    <img src="~/img/logo-escuro.png"  alt="Nome da biblioteca" class="logo logo-escuro" />
    <img src="~/img/logo-claro.png" alt="Nome da biblioteca" class="logo logo-claro" />
        </a>
</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menu">
            @* ===== Menu principal: muda conforme o perfil ===== *@
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" asp-controller="Livros" asp-action="Index">Catálogo</a></li>
                @if (!User.EhAdmin())
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Sobre">Sobre Nós</a>
                    </li>
                }

                @if (admin)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Cadastros</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Livros" asp-action="Create">Novo livro</a></li>
                            <li><a class="dropdown-item" asp-controller="Autores" asp-action="Index">Autores</a></li>
                            <li><a class="dropdown-item" asp-controller="Categorias" asp-action="Index">Categorias</a></li>
                            <li><a class="dropdown-item" asp-controller="Editoras" asp-action="Index">Editoras</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index">Usuários</a></li>

                        </ul>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Empréstimos</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Emprestimos" asp-action="Index">Disponíveis / Emprestados</a></li>
                            <li><a class="dropdown-item" asp-controller="Emprestimos" asp-action="Novo">Registrar empréstimo</a></li>
                            <li><a class="dropdown-item" asp-controller="Emprestimos" asp-action="Historico">Histórico</a></li>
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Newsletter" asp-action="Index">
                            Newsletter
                        </a>
                    </li>
                }
                else if (autenticado)
                {
                <li class="nav-item">
                    <a class="nav-link"
                    asp-controller="Conta"
                    asp-action="MeusEmprestimos">

                        Meus empréstimos
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                    asp-controller="Livros"
                    asp-action="MeusFavoritos">

                        Meus favoritos
                </a>
                </li>
            }
            </ul>

            @* ===== Aba de perfil (canto direito) ===== *@
            <ul class="navbar-nav ms-auto align-items-lg-center">
                <li class="nav-item dropdown">
                    @if (autenticado)
                    {
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown">
                            <span class="avatar">@inicial</span>
                            <span>@nome</span>
                            <span class="badge @(admin ? "text-bg-danger" : "text-bg-secondary")">@(admin ? "Admin" : "Usuário")</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><h6 class="dropdown-header">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</h6></li>
                            <li><a class="dropdown-item" asp-controller="Conta" asp-action="Perfil">Meu perfil</a></li>
                            <li><a class="dropdown-item" asp-controller="Conta" asp-action="MeusEmprestimos">Meus empréstimos</a></li>
                            <li><a class="dropdown-item" asp-controller="Conta" asp-action="Senha">Alterar senha</a></li>
                            <li><a class="dropdown-item" asp-controller="Conta" asp-action="Preferencias">Preferências</a></li>
                            <li><button type="button" class="dropdown-item" data-tema-toggle>🌙 Modo escuro</button></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Conta" asp-action="Logout" method="post">
                                    <button class="dropdown-item text-danger">Sair</button>
                                </form>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown">
                            <span class="avatar">
                                   <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
                                   </svg>
                                   </span><span>Perfil</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Conta" asp-action="Login">Entrar</a></li>
                            <li><a class="dropdown-item" asp-controller="Conta" asp-action="Registrar">Criar conta</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><button type="button" class="dropdown-item" data-tema-toggle>🌙 Modo escuro</button></li>
                        </ul>
                    }
                </li>
            </ul>
        </div>
    </div>
</nav>

<main class="container pb-5">
    <partial name="_Alertas" />
    @RenderBody()
</main>

        @{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

@if (!User.EhAdmin()
    && !(controller == "Conta"
         && (action == "Login" || action == "Registrar")))
        {
            <footer class="footer text-white">

                <div class="container">

                    <!-- NEWSLETTER -->     
                    <section class="newsletter-footer">

                        <div class="newsletter-card">

                            <div class="newsletter-icon">
                                <i class="bi bi-envelope-paper"></i>
                            </div>

                            <div class="newsletter-content">

                                <span class="newsletter-label">
                                    NOVIDADES DA BIBLIOTECA
                                </span>

                                <h2>Fique por dentro</h2>

                                <p>
                                    Receba novidades, recomendações de livros e informações
                                    sobre a nossa biblioteca diretamente no seu e-mail.
                                </p>

                                <form asp-controller="Home"
                                asp-action="Newsletter"
                                method="post"
                                class="newsletter-form">

                                    <div class="newsletter-input-group">

                                        <input type="email"
                                        name="Email"
                                        class="form-control"
                                        placeholder="Digite seu e-mail"
                                        required />

                                        <button type="submit" class="btn newsletter-btn">
                                            Assinar
                                        </button>

                                    </div>

                                </form>

                                <small class="newsletter-info">
                                    <i class="bi bi-shield-check"></i>
                                    Não enviamos spam. Você pode cancelar quando quiser.
                                </small>

                                @if (TempData["NewsletterSucesso"] != null)
                                {
                                    <div class="alert alert-success mt-3 mb-0">
                                        @TempData["NewsletterSucesso"]
                                    </div>
                                }

                                @if (TempData["NewsletterErro"] != null)
                                {
                                    <div class="alert alert-warning mt-3 mb-0">
                                        @TempData["NewsletterErro"]
                                    </div>
                                }

                            </div>

                        </div>

                    </section>
                    

                    <!-- DIVISOR -->
                    <hr class="footer-divider">

                    <!-- INFORMAÇÕES -->
                    <div class="row footer-info text-center text-md-start">

                        <!-- ENDEREÇO -->
                        <div class="col-md-4 mb-4 mb-md-0">

                            <h5>
                                <i class="bi bi-geo-alt me-2"></i>
                                Endereço
                            </h5>

                            <p>
                                Av. Paulista, 1250 — Bela Vista<br /> São Paulo – SP, CEP 01310-100.
                            </p>

                        </div>

                        <!-- HORÁRIO -->
                        <div class="col-md-4 mb-4 mb-md-0">

                            <h5>
                                <i class="bi bi-clock me-2"></i>
                                Horário de atendimento
                            </h5>

                            <p>
                                Seg a Sex: 8h às 18h<br>
                                Sáb e Feriados: 8h às 14h
                            </p>

                        </div>

                        <!-- CONTATO -->
                        <div class="col-md-4">

                            <h5>
                                <i class="bi bi-envelope me-2"></i>
                                Contato
                            </h5>

                            <p>
                                Email: weblib@gmail.com<br>
                                Tel: 11 97014-8717
                            </p>

                        </div>

                    </div>

                    <!-- DIVISOR -->
                    <hr class="footer-divider">

                    <!-- COPYRIGHT -->
                    <div class="footer-bottom text-center">

                        <p class="mb-0">
                            © 2026 WebLib. Todos os direitos reservados.
                        </p>

                    </div>

                </div>

            </footer>
        }

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
<script src="~/js/site.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
