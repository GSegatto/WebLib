@model UsuarioFormViewModel

@{
    ViewData["Title"] = Model.Id == 0 ? "Novo usuário" : "Editar usuário";
    var editando = Model.Id != 0;
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="mb-1">
            @ViewData["Title"]
        </h2>

        <p class="text-muted mb-0">
            @(editando
                ? "Altere as informações e permissões do usuário."
                : "Cadastre um novo usuário na biblioteca.")
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <form method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="row">

                    <div class="col-md-6 mb-4">
                        <label asp-for="Nome" class="form-label">
                            Nome
                        </label>

                        <input asp-for="Nome"
                               class="form-control"
                               placeholder="Digite o nome do usuário" />

                        <span asp-validation-for="Nome"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-4">
                        <label asp-for="Email" class="form-label">
                            E-mail
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               type="email"
                               placeholder="Digite o e-mail do usuário" />

                        <span asp-validation-for="Email"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="mb-4">
                    <label asp-for="TipoUsuarioId" class="form-label">
                        Tipo de usuário
                    </label>

                    <select asp-for="TipoUsuarioId"
                            asp-items="Model.Tipos"
                            class="form-select">

                        <option value="">Selecione o tipo de usuário...</option>

                    </select>

                    <span asp-validation-for="TipoUsuarioId"
                          class="text-danger"></span>
                </div>

                <hr class="my-4" />

                <div class="mb-3">
                    <h5 class="mb-1">
                        Senha
                    </h5>

                    <p class="text-muted small mb-0">
                        @(editando
                            ? "Preencha somente se quiser alterar a senha atual."
                            : "Defina uma senha para o acesso do usuário.")
                    </p>
                </div>

                <div class="row">

                    <div class="col-md-6 mb-4">
                        <label asp-for="Senha" class="form-label">
                            Senha
                        </label>

                        <input asp-for="Senha"
                               class="form-control"
                               type="password"
                               autocomplete="new-password"
                               placeholder="Digite a senha" />

                        <span asp-validation-for="Senha"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-4">
                        <label asp-for="ConfirmarSenha" class="form-label">
                            Confirmar senha
                        </label>

                        <input asp-for="ConfirmarSenha"
                               class="form-control"
                               type="password"
                               autocomplete="new-password"
                               placeholder="Digite a senha novamente" />

                        <span asp-validation-for="ConfirmarSenha"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>
                        Salvar
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>